# ====================================================
# GTOPagos Frontend - Variables de Entorno para Vercel
# Configurar estas variables en el panel de Vercel:
# Project Settings -> Environment Variables
# ====================================================

# URL base del backend REST (ejemplo: http://api.tudominio.com:1450 o http://localhost:8000)
BACKEND_API_URL=http://localhost:8000

# Clave secreta compartida con la bóveda Nginx del backend
PROXY_VAULT_KEY=genera_aqui_tu_clave_secreta_de_boveda

# Origen permitido del frontend
FRONTEND_ORIGIN=https://tu-proyecto.vercel.app
